CLIENT_PORTAL_ENVIRONMENT=development
CLIENT_PORTAL_DATABASE_URL=postgresql+psycopg://repaircrm_client:repaircrm_client@postgres:5432/repaircrm_client
CLIENT_PORTAL_SECRET_KEY=change-me-in-production-use-strong-secret
CLIENT_PORTAL_SYNC_API_KEY=change-me-sync-token
CLIENT_PORTAL_TENANT_KEY=default
CLIENT_PORTAL_TOKEN_TTL_MINUTES=43200
CLIENT_PORTAL_REFRESH_TOKEN_TTL_DAYS=60
CLIENT_PORTAL_AUTH_POLICY=phone_or_email
CLIENT_PORTAL_REQUIRE_VERIFIED_CONTACT_FOR_ORDERS=true
CLIENT_PORTAL_BRAND_NAME=Repair CRM
CLIENT_PORTAL_ACCENT_COLOR=#0f766e
CLIENT_PORTAL_LOGO_URL=
CLIENT_PORTAL_SUPPORT_PHONE=
CLIENT_PORTAL_SUPPORT_EMAIL=
CLIENT_PORTAL_PUBLIC_SITE_URL=
CLIENT_PORTAL_GOOGLE_TAG_ID=
CLIENT_PORTAL_YANDEX_METRIKA_ID=
CLIENT_PORTAL_DELIVERY_DEBUG=true
CLIENT_PORTAL_CORS_ORIGINS=*
CLIENT_PORTAL_RATE_LIMIT_ENABLED=true
CLIENT_PORTAL_RATE_LIMIT_WINDOW_SECONDS=60
CLIENT_PORTAL_RATE_LIMIT_DEFAULT_LIMIT=120
CLIENT_PORTAL_RATE_LIMIT_AUTH_LIMIT=20
CLIENT_PORTAL_REDIS_URL=redis://redis:6379/0
CLIENT_PORTAL_CRM_BASE_URL=
CLIENT_PORTAL_CRM_API_KEY=
CLIENT_PORTAL_CRM_TENANT_KEY=
CLIENT_PORTAL_SYNC_WORKER_INTERVAL_SECONDS=60
CLIENT_PORTAL_SYNC_WORKER_BATCH_SIZE=100
CLIENT_PORTAL_MOBILE_PUSH_ENABLED=false
CLIENT_PORTAL_MOBILE_PUSH_PROVIDER=stub
CLIENT_PORTAL_MOBILE_PUSH_API_KEY=

# Postgres Docker image settings
POSTGRES_DB=repaircrm_client
POSTGRES_USER=repaircrm_client
POSTGRES_PASSWORD=repaircrm_client

# Port overrides (optional — defaults shown)
POSTGRES_PORT=55440
REDIS_PORT=56379
BACKEND_PORT=8040
FRONTEND_PORT=4300
